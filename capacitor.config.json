{
  "appId": "app.harbored",
  "appName": "Harbored",
  "webDir": "dist",
  "backgroundColor": "#0a1628",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a1628"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0a1628",
      "showSpinner": false
    }
  }
}
